# Training outputs (Isaac Lab writes logs/ relative to the cwd)
logs/
outputs/
*.pt
*.onnx
# ...except the deployable models the Unity machine needs (policies < 4 MB, world model ~17 MB)
!export/models/*.onnx
*.ckpt

# Per-run raw logs (README.md / run_info.txt in experiments/ are tracked)
experiments/**/train.log
experiments/**/vram.csv

# Python
__pycache__/
*.pyc
.venv/

# Unity
unity/[Ll]ibrary/
unity/[Tt]emp/
unity/[Oo]bj/
unity/[Bb]uild/
unity/[Bb]uilds/
unity/[Ll]ogs/
unity/[Uu]ser[Ss]ettings/
unity/*.csproj
unity/*.sln
# Copies of export/models/*.onnx made by the BMB/Sync models menu (export/models/ is the tracked original)
unity/Assets/Resources/BMB/Models/
unity/Assets/Resources/BMB/Models.meta

